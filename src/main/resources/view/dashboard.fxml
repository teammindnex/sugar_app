<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sugarcane.erp.controller.DashboardController" styleClass="root">
    <left>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" hbarPolicy="NEVER">
            <VBox spacing="20" styleClass="sidebar-container" prefWidth="320">
                <padding><Insets top="20" right="15" bottom="20" left="15"/></padding>
            
            <!-- Branding Section (Stacked Vertically) -->
            <VBox alignment="TOP_CENTER" spacing="10">
                <Label text="!! जय शारदा गजानन प्रसन्न !!" style="-fx-text-fill: red; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                <Label text="श्री गणेश कृपा ऊस सप्लायर्स" styleClass="bill-title-maroon-sidebar"/>
                
                <VBox alignment="CENTER" styleClass="bill-subtitle-pill-sidebar">
                    <Label text="खास रसवंतीसाठी वापरल्या जाणाऱ्या खेडशिवापूर च्या ऊसाचे होलसेल विक्रेते" styleClass="bill-subtitle-text-sidebar" wrapText="true" textAlignment="CENTER" maxWidth="300"/>
                </VBox>
                
                <HBox alignment="CENTER" spacing="10">
                    <VBox spacing="2" alignment="CENTER">
                        <Label text="पत्ता: ..." style="-fx-font-size: 11px;"/>
                    </VBox>
                </HBox>
                
                <Separator style="-fx-opacity: 0.3;" />
                
                <VBox spacing="2" alignment="TOP_CENTER">
                    <Label text="प्रोप्रा. बाबासो कोंडे ९४४४३९४८५१ / ९५५२२३७१२३" style="-fx-font-size: 12px;"/>
                    <Label text="प्रोप्रा. विराज कोंडे ९५५२२३७१२२ / ८९९९८७४८८६" style="-fx-font-size: 12px;"/>
                </VBox>
                
            </VBox>

            <Separator style="-fx-opacity: 0.3;" />

            <!-- Navigation Section -->
            <VBox spacing="5" alignment="CENTER">
                <Button text="डॅशबोर्ड (Dashboard)" onAction="#showDashboardHome" styleClass="nav-button-sidebar, active" maxWidth="Infinity" />
                <Button text="शेतकरी (Farmer)" onAction="#showFarmer" styleClass="nav-button-sidebar" maxWidth="Infinity" />
                <Button text="ग्राहक (Customer)" onAction="#showCustomer" styleClass="nav-button-sidebar" maxWidth="Infinity" />
                <Button text="कामगार (Worker)" onAction="#showWorker" styleClass="nav-button-sidebar" maxWidth="Infinity" />
                <Button text="ट्रान्सपोर्ट (Transport)" onAction="#showTransport" styleClass="nav-button-sidebar" maxWidth="Infinity" />
                <Button text="सेटिंग्स (Settings)" onAction="#showSettings" styleClass="nav-button-sidebar" maxWidth="Infinity" />
                
                <Region prefHeight="10.0" />
                <Button text="बाहेर पडा (Logout)" onAction="#handleLogout" styleClass="nav-button-sidebar" maxWidth="Infinity" style="-fx-text-fill: #ef4444; -fx-font-weight: bold;"/>
            </VBox>
            
            <Region VBox.vgrow="ALWAYS" />
            
            <VBox alignment="CENTER" spacing="5">
                <Button text="English" onAction="#switchEnglish" styleClass="button-secondary" maxWidth="Infinity" />
                <Button text="मराठी" onAction="#switchMarathi" styleClass="button-secondary" maxWidth="Infinity" />
            </VBox>
            </VBox>
        </ScrollPane>
    </left>

    <center>
        <StackPane fx:id="contentArea">
            <ScrollPane vbarPolicy="ALWAYS" fx:id="dashboardHome" fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent; -fx-background: #f1f5f9; -fx-border-color: transparent;">
                <VBox spacing="30" styleClass="dashboard-container" alignment="TOP_CENTER">
                    <padding>
                        <Insets top="50" right="40" bottom="50" left="40"/>
                    </padding>
                    
                    <VBox spacing="10" alignment="CENTER">
                        <Label text="श्री गणेश कृपा ऊस सप्लायर्स" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                        <Label text="डॅशबोर्डवर आपले स्वागत आहे (Welcome to Dashboard)" style="-fx-font-size: 16px; -fx-text-fill: #64748b;"/>
                    </VBox>
                    
                    <HBox spacing="30" alignment="CENTER">
                        <!-- Today's Sales Card -->
                        <VBox spacing="15" styleClass="dashboard-card, card-blue" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Label text="💰" style="-fx-font-size: 32px;"/>
                                <VBox>
                                    <Label text="आजची विक्री" styleClass="card-title"/>
                                    <Label text="Today's Sales" styleClass="card-subtitle"/>
                                </VBox>
                            </HBox>
                            <Label fx:id="todaySalesLabel" text="₹ 0.00" styleClass="card-value"/>
                        </VBox>
                        
                        <!-- Today's Purchases Card -->
                        <VBox spacing="15" styleClass="dashboard-card, card-red" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Label text="🛒" style="-fx-font-size: 32px;"/>
                                <VBox>
                                    <Label text="आजची खरेदी" styleClass="card-title"/>
                                    <Label text="Today's Purchases" styleClass="card-subtitle"/>
                                </VBox>
                            </HBox>
                            <Label fx:id="todayPurchaseLabel" text="₹ 0.00" styleClass="card-value"/>
                        </VBox>

                        <!-- Today's Profit Card -->
                        <VBox spacing="15" styleClass="dashboard-card, card-green" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Label text="💸" style="-fx-font-size: 32px;"/>
                                <VBox>
                                    <Label text="आजचा नफा" styleClass="card-title"/>
                                    <Label text="Today's Profit" styleClass="card-subtitle"/>
                                </VBox>
                            </HBox>
                            <Label fx:id="todayProfitLabel" text="₹ 0.00" styleClass="card-value"/>
                        </VBox>
                    </HBox>
                    
                    <!-- We still keep other existing cards underneath the 3 large ones -->
                    <GridPane alignment="CENTER" hgap="20" vgap="20" style="-fx-padding: 20 0 0 0;">
                        
                        <VBox styleClass="card" minWidth="220" minHeight="120" alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="%today.collection" styleClass="sub-header-label" />
                            <Label fx:id="todayCollectionLabel" text="₹ 0.00" styleClass="header-label" style="-fx-text-fill: -primary-color; -fx-font-size: 28px; -fx-padding: 10 0 0 0;" />
                        </VBox>
                        <VBox styleClass="card" minWidth="220" minHeight="120" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="%today.payments" styleClass="sub-header-label" />
                            <Label fx:id="todayPaymentsLabel" text="₹ 0.00" styleClass="header-label" style="-fx-text-fill: -error-color; -fx-font-size: 28px; -fx-padding: 10 0 0 0;" />
                        </VBox>
                        <VBox styleClass="card" minWidth="220" minHeight="120" alignment="CENTER" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <Label text="%today.expenses" styleClass="sub-header-label" />
                            <Label fx:id="todayExpensesLabel" text="₹ 0.00" styleClass="header-label" style="-fx-text-fill: -error-color; -fx-font-size: 28px; -fx-padding: 10 0 0 0;" />
                        </VBox>
                        
                        <VBox styleClass="card" minWidth="220" minHeight="120" alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="%total.farmers" styleClass="sub-header-label" />
                            <Label fx:id="totalFarmersLabel" text="0" styleClass="header-label" style="-fx-font-size: 28px; -fx-padding: 10 0 0 0;" />
                        </VBox>
                        <VBox styleClass="card" minWidth="220" minHeight="120" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="%total.customers" styleClass="sub-header-label" />
                            <Label fx:id="totalCustomersLabel" text="0" styleClass="header-label" style="-fx-font-size: 28px; -fx-padding: 10 0 0 0;" />
                        </VBox>
                        <VBox styleClass="card" minWidth="220" minHeight="120" alignment="CENTER" GridPane.columnIndex="2" GridPane.rowIndex="1">
                            <Label text="%total.vehicles" styleClass="sub-header-label" />
                            <Label fx:id="totalVehiclesLabel" text="0" styleClass="header-label" style="-fx-font-size: 28px; -fx-padding: 10 0 0 0;" />
                        </VBox>
                    </GridPane>
                    
                    <HBox spacing="20" alignment="CENTER">
                        <Button text="रिफ्रेश करा (Refresh)" onAction="#loadDashboardStatsAction" styleClass="refresh-button" />
                    </HBox>
                </VBox>
            </ScrollPane>
        </StackPane>
    </center>
    
</BorderPane>
