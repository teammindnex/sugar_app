<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sugarcane.erp.controller.WorkerController" styleClass="root">
    
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent;">
            <VBox spacing="20" style="-fx-background-color: white;">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                
                <Label text="कामगार व्यवस्थापन" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                
                <VBox spacing="15" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4;">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                    
                    <Label text="कामगार जोडा / दुरुस्त करा" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    
                    <GridPane hgap="15" vgap="15">
                        <Label text="कामगाराचे नाव:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="nameField" promptText="उदा. रमेश" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        
                        <Label text="मोबाईल नंबर:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <TextField fx:id="mobileField" promptText="10 अंकी नंबर" prefWidth="250" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                    </GridPane>
                    
                    <HBox spacing="10">
                        <padding><Insets top="10"/></padding>
                        <Button text="कामगार जोडा" onAction="#handleSave" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-padding: 8 20;"/>
                        <Button text="बदल जतन करा" onAction="#handleUpdate" style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-padding: 8 20;"/>
                        <Button text="साफ करा" onAction="#handleClear" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-padding: 8 20;"/>
                    </HBox>
                </VBox>
                
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="कामगार शोधा:" />
                    <TextField fx:id="searchField" promptText="नावाने शोधा..." prefWidth="300"/>
                    <Button text="रिफ्रेश" onAction="#loadWorkers" style="-fx-background-color: #94a3b8; -fx-text-fill: white;" />
                    
                    <Region HBox.hgrow="ALWAYS" />
                    
                    <Button text="हजेरी" style="-fx-background-color: #a855f7; -fx-text-fill: white;"/>
                    <Button text="मासिक हजेरी रिपोर्ट" style="-fx-background-color: #f59e0b; -fx-text-fill: white;"/>
                    <Button text="पैसे द्या" style="-fx-background-color: #22c55e; -fx-text-fill: white;"/>
                    <Button text="संपूर्ण हिशोब" style="-fx-background-color: #3b82f6; -fx-text-fill: white;"/>
                    <Button text="काढा" onAction="#handleDelete" style="-fx-background-color: #ef4444; -fx-text-fill: white;"/>
                </HBox>
                
                <TableView fx:id="workerTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="100"/>
                        <TableColumn fx:id="colName" text="नाव" prefWidth="250"/>
                        <TableColumn fx:id="colMobile" text="मोबाईल" prefWidth="200"/>
                        <TableColumn fx:id="colBalance" text="बाकी" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>
        </ScrollPane>
    </center>
    
</BorderPane>
