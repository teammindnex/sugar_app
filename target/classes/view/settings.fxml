<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sugarcane.erp.controller.SettingsController" styleClass="root">
    
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="card">
            <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
            <Label text="%menu.settings" styleClass="header-label" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="20.0" alignment="TOP_CENTER">
                <padding><Insets top="40" right="100" bottom="40" left="100"/></padding>
                
                <VBox spacing="10" styleClass="card" maxWidth="600">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    <Label text="Application Settings" styleClass="sub-header-label" />
                    
                    <Label text="Company Name" styleClass="label" />
                    <TextField fx:id="companyNameField" />
                    
                    <Label text="Language" styleClass="label" />
                    <ComboBox fx:id="languageComboBox" maxWidth="Infinity" />
                    
                    <Label text="Theme" styleClass="label" />
                    <ComboBox fx:id="themeComboBox" maxWidth="Infinity" />
                    
                    <Button text="Save Settings" onAction="#handleSave" styleClass="button" maxWidth="Infinity" style="-fx-margin-top: 15px;" />
                </VBox>
                
                <VBox spacing="10" styleClass="card" maxWidth="600">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    <Label text="Database Management" styleClass="sub-header-label" />
                    <Label text="Backup your data regularly to prevent data loss. Restoring a database will overwrite current data." wrapText="true" />
                    
                    <HBox spacing="10" alignment="CENTER">
                        <Button text="Backup Database" onAction="#handleBackup" styleClass="button-secondary" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                        <Button text="Restore Database" onAction="#handleRestore" style="-fx-background-color: -error-color; -fx-text-fill: white;" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                    </HBox>
                    <Button text="सर्व डेटा डिलीट करा (Testing Only)" onAction="#handleClearData" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-margin-top: 15px;" maxWidth="Infinity" />
                </VBox>
                
            </VBox>
        </ScrollPane>
    </center>
    
</BorderPane>
